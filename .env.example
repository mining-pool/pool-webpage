# Server-side dev proxy target. No credentials belong in VITE_* variables.
NOMP_API_TARGET=http://127.0.0.1:20000
# Set this to the Go API origin for a separately deployed frontend.
# Leave empty in local development to use the Vite proxy above.
VITE_API_BASE_URL=
VITE_POOL_NAME=NOMP Pool
VITE_STRATUM_HOST=pool.example.com
